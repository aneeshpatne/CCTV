<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aneesh.cctv.motion</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/aneeshpatne/Desktop/Code/CCTV &amp;&amp; exec /Users/aneeshpatne/Desktop/Code/CCTV/.venv/bin/python -m motion.motion</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>PYTHONPATH</key>
    <string>/Users/aneeshpatne/Desktop/Code/CCTV</string>
    <key>HOME</key>
    <string>/Users/aneeshpatne</string>
    <key>DATA_DIR</key>
    <string>/Volumes/HP USB20FD/CCTV/motion/data</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/aneeshpatne/Library/Logs/CCTV/motion.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/aneeshpatne/Library/Logs/CCTV/motion.err.log</string>
</dict>
</plist>
