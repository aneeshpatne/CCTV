<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aneesh.cctv.server</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/aneeshpatne/Desktop/Code/CCTV &amp;&amp; exec /Users/aneeshpatne/Desktop/Code/CCTV/.venv/bin/python -m server.server</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>PYTHONPATH</key>
    <string>/Users/aneeshpatne/Desktop/Code/CCTV</string>
    <key>CCTV_RECORDINGS_DIR</key>
    <string>/Volumes/HP USB20FD/CCTV/recordings/esp_cam1</string>
    <key>MOTION_DB_DIR</key>
    <string>/Volumes/HP USB20FD/CCTV/recordings/esp_cam1</string>
    <key>MOTION_DATA_DIR</key>
    <string>/Volumes/HP USB20FD/CCTV/motion/data</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/Users/aneeshpatne/Library/Logs/CCTV/server.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/aneeshpatne/Library/Logs/CCTV/server.err.log</string>
</dict>
</plist>
