<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aneesh.cctv.orchestrator</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/aneeshpatne/Desktop/Code/CCTV &amp;&amp; exec /Users/aneeshpatne/Desktop/Code/CCTV/.venv/bin/python -m image_processing.pipeline_orchestrator</string>
  </array>

<key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>PYTHONPATH</key>
    <string>/Users/aneeshpatne/Desktop/Code/CCTV</string>
    <key>CCTV_RECORDINGS_DIR</key>
    <string>/Volumes/drive/CCTV/recordings/esp_cam1</string>
    <key>CCTV_PIPELINE_BACKEND</key>
    <string>native</string>
    <key>CCTV_NATIVE_BINARY</key>
    <string>/Users/aneeshpatne/Desktop/Code/CCTV/native/.build/release/cctv-capture</string>
    <key>CCTV_TARGET_FPS</key>
    <string>9</string>
    <key>CCTV_LOCAL_CODEC</key>
    <string>hevc</string>
    <key>CCTV_AUTO_WB_MODE</key>
    <string>oneshot</string>
    <key>CCTV_WB_TARGET_RED_OVER_GREEN</key>
    <string>0.92</string>
    <key>CCTV_WB_TARGET_BLUE_OVER_GREEN</key>
    <string>0.95</string>
    <key>CCTV_WB_MAX_DEVIATION_FRACTION</key>
    <string>0.25</string>
    <key>CCTV_WB_MIN_SCENE_BRIGHTNESS</key>
    <string>0.18</string>
    <key>CCTV_WB_MAX_HUNT_STEPS</key>
    <string>4</string>
    <key>CCTV_WB_DRIFT_THRESHOLD</key>
    <string>6</string>
    <key>CCTV_WB_DRIFT_REOPEN_COOLDOWN_SECONDS</key>
    <string>45</string>
    <key>CCTV_WB_DRIFT_CHECK_INTERVAL_SECONDS</key>
    <string>20</string>
    <key>CCTV_MANUAL_GAIN_MAX_X16</key>
    <string>31</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/Users/aneeshpatne/Library/Logs/CCTV/orchestrator.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/aneeshpatne/Library/Logs/CCTV/orchestrator.err.log</string>
</dict>
</plist>
